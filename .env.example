# Instance configuration (non-secret, used by docker compose variable
# interpolation). Copy to .env and adjust:
#   cp .env.example .env
#
# .env is excluded from git. You only need this when running multiple
# instances on one Docker host - for a single deployment the defaults
# (shown below) are used automatically and no .env is required.

# Unique name for the compose project, the container and the Traefik
# router/service. Pick something short and personal, e.g. "brita-dev".
INSTANCE_NAME=remote-dev-env

# Public hostname served by Traefik (production only, has no effect locally).
DOMAIN=chris.dev.tidesson.net
